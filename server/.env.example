# ── Server Configuration
PORT=5000
NODE_ENV=development

# ── CORS Configuration
# Allowed origin for CORS requests in production environment.
# Fallback in development is http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── MongoDB Configuration
# Connection URI for Mongoose.
MONGO_URI=mongodb://localhost:27017/placementgps

# ── JWT Configuration
# Expiration is set to 30d for Remember Me support.
JWT_SECRET=your_jwt_secret_here_change_in_production

# ── SMTP (Email OTP) Configuration
# Nodemailer configuration parameters.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=noreply@placementgps.ai

# ── SMS (Twilio SMS OTP) Configuration
# API credentials for Twilio SMS integration.
SMS_PROVIDER_API_KEY=your_twilio_account_sid
SMS_PROVIDER_SECRET=your_twilio_auth_token
SMS_SENDER_ID=your_twilio_purchased_phone_number

# ── Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# ── Debugging Configuration
# Set to true to print OTP values directly to backend terminal in development mode.
# Has no effect if NODE_ENV is set to production.
DEBUG_OTP=true
